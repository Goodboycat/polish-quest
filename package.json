{
  "name": "polish-quest",
  "private": true,
  "type": "module",
  "scripts": {
    "build:3d": "esbuild src3d/scene.js --bundle --minify --format=iife --target=es2019 --outfile=site/js/scene.bundle.js && esbuild src3d/game.js --bundle --minify --format=iife --target=es2019 --outfile=site/play/game.bundle.js",
    "dev": "npm run build:3d && wrangler pages dev site --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build:3d && wrangler pages deploy site --project-name polish-quest"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "three": "^0.170.0",
    "wrangler": "^4.110.0"
  }
}